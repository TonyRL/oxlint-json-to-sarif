{
  "name": "oxlint-json-to-sarif",
  "version": "0.2.0",
  "description": "Convert oxlint JSON output to SARIF",
  "keywords": [
    "converter",
    "lint",
    "oxlint",
    "oxc",
    "sarif",
    "static-analysis"
  ],
  "license": "MIT",
  "author": "TonyRL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TonyRL/oxlint-json-to-sarif.git"
  },
  "bin": {
    "oxlint-json-to-sarif": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "node-sarif-builder": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/sarif": "^2.1.7",
    "@vitest/coverage-v8": "^4.1.2",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^0.24.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
